{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "小红蚁",
  "version": "1.0.0",
  "identifier": "com.magicCzc.xiaohongyi",
  "build": {
    "frontendDist": "../dist",
    "beforeDevCommand": "npm run client:dev",
    "beforeBuildCommand": "node scripts/sync-tauri-resources.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "小红蚁",
        "width": 1400,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 640,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": false,
        "center": true,
        "devtools": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:14753 http://localhost:14753 http://localhost:5173; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; media-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": [
      "binaries/xiaohongyi-backend"
    ],
    "resources": {
      "resources/api-dist": "api-dist",
      "resources/node_modules": "node_modules",
      "resources/.env.example": ".env.example"
    },
    "copyright": "Copyright © 2026 magicCzc",
    "category": "Productivity",
    "shortDescription": "小红蚁 - AI 智能小红书运营助手",
    "longDescription": "小红蚁是面向小红书博主的 AI 一站式运营助手,支持内容创作、视频工程、竞品监控、数据分析等核心能力。",
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installMode": "perMachine",
        "displayLanguageSelector": false,
        "languages": [
          "SimpChinese",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://releases.xiaohongyi.example.com/update/{{target}}-{{arch}}/{{current_version}}"
      ],
      "dialog": true,
      "pubkey": ""
    }
  }
}
