{
  "name": "xiaohongyi",
  "private": true,
  "version": "1.0.0",
  "description": "小红蚁 - AI 智能小红书运营助手",
  "engines": {
    "node": ">=22.0.0 <23.0.0",
    "npm": ">=10.0.0"
  },
  "type": "module",
  "scripts": {
    "client:dev": "vite",
    "server:dev": "nodemon",
    "dev": "concurrently -k -n web,api -c blue,green \"npm run client:dev\" \"npm run server:dev\"",
    "ai": "tsx AI/cli.ts",
    "build:frontend": "vite build",
    "build": "npm run build:frontend && npm run build:api && npm run build:sidecar",
    "lint": "eslint .",
    "preview": "vite preview",
    "check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:frontend": "vitest run --config vitest.frontend.config.ts",
    "test:e2e": "node tests/e2e/ux-flows.mjs",
    "test:e2e:business": "node tests/e2e/business-flows.mjs",
    "test:e2e:prod": "node tests/e2e/run-prod-e2e.mjs",
    "ci": "node scripts/ci.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "build:api": "node scripts/build-api.mjs",
    "build:sidecar": "node scripts/build-sidecar.mjs",
    "tauri:dev": "npm run build:api && node scripts/sync-tauri-resources.mjs && concurrently -k -n api,desktop -c green,blue \"npm run server:dev\" \"wait-on tcp:14753 && cargo tauri dev --dev-url http://localhost:5173\"",
    "tauri:dev:frontend": "cargo tauri dev --dev-url http://localhost:5173",
    "tauri:build": "npm run build:frontend && npm run build:api && node scripts/sync-tauri-resources.mjs && npm run build:sidecar && cargo tauri build",
    "tauri:build:win": "npm run build:frontend && npm run build:api && node scripts/sync-tauri-resources.mjs && npm run build:sidecar && cargo tauri build"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-global-shortcut": "^2.3.2",
    "ali-oss": "^6.23.0",
    "axios": "^1.13.2",
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^12.6.2",
    "cheerio": "^1.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.1",
    "drizzle-orm": "^0.45.2",
    "express": "^4.21.2",
    "express-rate-limit": "^8.5.2",
    "ffmpeg-static": "^5.3.0",
    "fluent-ffmpeg": "^2.1.3",
    "ghost-cursor": "^1.4.2",
    "html2canvas": "^1.4.1",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^0.511.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "openai": "^6.16.0",
    "playwright": "^1.57.0",
    "playwright-extra": "^4.3.6",
    "puppeteer-extra-plugin-stealth": "^2.11.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-router-dom": "^7.3.0",
    "recharts": "^3.7.0",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "winston-daily-rotate-file": "^5.0.0",
    "xlsx": "^0.18.5",
    "zod": "^4.3.6",
    "zustand": "^5.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@rollup/plugin-commonjs": "^28.0.6",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.0.0",
    "@types/node": "^22.15.30",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/uuid": "^11.0.0",
    "@vercel/node": "^5.3.6",
    "@vitejs/plugin-react": "^4.4.1",
    "autoprefixer": "^10.4.21",
    "babel-plugin-react-dev-locator": "^1.0.0",
    "concurrently": "^9.2.4",
    "drizzle-kit": "^0.31.10",
    "esbuild": "^0.24.0",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "happy-dom": "^20.11.0",
    "nodemon": "^3.1.10",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "tsx": "^4.20.3",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.3.5",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.0.18",
    "wait-on": "^9.1.0"
  }
}
