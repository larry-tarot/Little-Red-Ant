# Port Configuration
# 桌面版主进程会自动设置 PORT=3001
# Web 版:留空用默认 3001
# PORT=3001

# AI Provider Configuration
# Aliyun (Tongyi Qianwen) - Required for AI content generation
ALIYUN_API_KEY=your_aliyun_api_key_here

# DeepSeek (Optional)
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# OpenAI (Optional)
OPENAI_API_KEY=your_openai_api_key_here

# Security
# JWT Secret for authentication (Change this in production!)
JWT_SECRET=your_jwt_secret_key_change_me_please

# Cookie Encryption Key (Recommended for production)
# If not set, falls back to JWT_SECRET. Set a separate key to isolate encryption
# from authentication. Use a random 32+ character string.
# COOKIE_ENCRYPTION_KEY=your-32-char-encryption-key-here

# Production Environment
# Uncomment to enforce production mode (requires JWT_SECRET to be set)
# NODE_ENV=production

# RPA Driver
# 'playwright' (default) | 'camoufox' (experimental)
# RPA_DRIVER=playwright

# Rate Limiting
# Default: 1000 requests per 15 minutes for general API, 20 for auth
# RATE_LIMIT_MAX=1000
# AUTH_RATE_LIMIT_MAX=20

# Browser Automation (RPA)
# Path to Chrome executable (Optional, Playwright usually manages this)
# CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe